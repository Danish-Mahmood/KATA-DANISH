{
    "name": "tilemountain/php8-kata",
    "description": "STAC-221 B1.1 PHP 8 kata for JavaScript developers",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "nyholm/psr7": "^1.8",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
